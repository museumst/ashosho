rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "museumst@gmail.com";
    }

    function isImageUnderLimit() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    function isBoardImageUnderLimit() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    match /photography/{path=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.auth.token.email_verified == true && isImageUnderLimit();
      allow delete: if isAdmin() && request.auth.token.email_verified == true;
    }

    match /photography-private/{path=**} {
      allow get, delete: if isAdmin() && request.auth.token.email_verified == true;
      allow create: if isAdmin() && request.auth.token.email_verified == true && isImageUnderLimit();
    }

    match /board/{path=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isBoardImageUnderLimit();
      allow delete: if isAdmin();
    }
  }
}
